# ============================================================
# .env.production.example
# Plantilla para el entorno de producción en Hostinger.
# Copia este archivo a .env en el servidor y rellena los valores.
# NUNCA subas el .env real al repositorio.
# ============================================================

NODE_ENV=production

# Puerto asignado por Hostinger en el panel Node.js
PORT=3000

# ── Base de Datos (credenciales del panel Hostinger → Databases) ──
DB_HOST=localhost
DB_USER=u123456789_usuario       # usuario creado en Hostinger
DB_PASSWORD=TuPasswordSegura123  # password definido en Hostinger
DB_NAME=u123456789_nombre_bd     # nombre de la base de datos

# ── Cloudinary (sin cambios respecto al desarrollo) ──
CLOUDINARY_URL=cloudinary://ACCOUNT_KEY:ACCOUNT_SECRET@CLOUD_NAME

# ── URLs del sistema ──
# URL pública del frontend (sin barra final)
FRONTEND_URL=https://aquavisor.co

# Ruta del formulario en el frontend (sin barra final).
# DEBE coincidir con la ruta que usa el router del frontend.
# Si el frontend tiene /formulario/:formId, usar: /formulario
# Cambiar aquí si el frontend cambia su path.
REFERRAL_FORM_PATH=/formulario

# URL base de la API para Swagger (incluye /api, sin barra final)
# Dominio temporal Hostinger (cambiar cuando se configure api.aquavisor.co)
SERVER_URL=https://whitesmoke-mule-772754.hostingersite.com/api

# ── JWT ──
# Usa una clave larga y aleatoria en producción (mínimo 32 caracteres)
JWT_SECRET=reemplaza_esto_con_una_clave_muy_segura_y_larga_2025
#
# 30d, no 8h, por el trabajo de campo offline: una jornada de censo dura más de
# 8h y no existe refresh token. Con 8h el inspector se quedaba con la cola de
# encuestas sin poder sincronizar (o, peor, sincronizándolas sin atribución
# antes de que se corrigiera DEF-01). Ver specs/offline-encuestas.md.
JWT_EXPIRES_IN=30d
